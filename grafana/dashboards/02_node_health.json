{
  "uid": "dabeat-health",
  "title": "DABEAT \u2014 Node Health",
  "tags": [
    "dabeat"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sync Lag (blocks)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time,\n              da_layer AS metric,\n              MAX(sync_lag) AS value\n       FROM node_health WHERE $__timeFilter(ts)\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4,
            "fillOpacity": 10,
            "axisLabel": ""
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Celestia Peer Count",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time,\n              'peers' AS metric, AVG(peers_count) AS value\n       FROM node_health WHERE da_layer='celestia' AND peers_count IS NOT NULL AND $__timeFilter(ts)\n       GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
