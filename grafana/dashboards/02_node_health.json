    {
      "id": 7,
      "type": "timeseries",
      "title": "RPC Latency Percentiles (ms)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('5 minute', ts) AS time,\n              da_layer || '_p50' AS metric,\n              percentile_cont(0.5) WITHIN GROUP (ORDER BY rpc_latency_ms) AS value\n       FROM node_health WHERE rpc_latency_ms IS NOT NULL AND $__timeFilter(ts)\n       GROUP BY 1, da_layer\n       UNION ALL\n       SELECT time_bucket('5 minute', ts) AS time,\n              da_layer || '_p95' AS metric,\n              percentile_cont(0.95) WITHIN GROUP (ORDER BY rpc_latency_ms) AS value\n       FROM node_health WHERE rpc_latency_ms IS NOT NULL AND $__timeFilter(ts)\n       GROUP BY 1, da_layer\n       UNION ALL\n       SELECT time_bucket('5 minute', ts) AS time,\n              da_layer || '_p99' AS metric,\n              percentile_cont(0.99) WITHIN GROUP (ORDER BY rpc_latency_ms) AS value\n       FROM node_health WHERE rpc_latency_ms IS NOT NULL AND $__timeFilter(ts)\n       GROUP BY 1, da_layer\n       ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
