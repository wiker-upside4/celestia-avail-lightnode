    {
      "id": 3,
      "type": "timeseries",
      "title": "Celestia Bandwidth Rate (KB/s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time,\n              'rate_in' AS metric, AVG(rate_in)/1024.0 AS value\n       FROM node_health WHERE da_layer='celestia' AND $__timeFilter(ts)\n       GROUP BY 1\n       UNION ALL\n       SELECT time_bucket('1 minute', ts) AS time,\n              'rate_out' AS metric, AVG(rate_out)/1024.0 AS value\n       FROM node_health WHERE da_layer='celestia' AND $__timeFilter(ts)\n       GROUP BY 1\n       ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
