    {
      "id": 9,
      "type": "timeseries",
      "title": "RPC Latency (ms)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time,\n              da_layer AS metric,\n              AVG(rpc_latency_ms) AS value\n       FROM node_health WHERE $__timeFilter(ts)\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
