      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT date_trunc('hour', no.ts) AS time,\n              EXTRACT(HOUR FROM no.ts)::text AS metric,\n              SUM(no.blob_count) AS value\n       FROM namespace_observations no\n       WHERE no.da_layer='avail' AND $__timeFilter(no.ts)\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
