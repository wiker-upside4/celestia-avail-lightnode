    {
      "id": 5,
      "type": "barchart",
      "title": "Top Active Namespaces (24h, Avail)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT COALESCE(mn.rollup_name, no.namespace_or_appid) AS namespace,\n              SUM(no.blob_count) AS blobs,\n              SUM(no.total_bytes) AS bytes\n       FROM namespace_observations no\n       LEFT JOIN monitored_namespaces mn ON mn.da_layer=no.da_layer AND mn.namespace_or_appid=no.namespace_or_appid\n       WHERE no.da_layer='avail' AND no.ts > NOW() - INTERVAL '24 hours'\n       GROUP BY 1 ORDER BY blobs DESC LIMIT 10",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Avail Activity by Hour of Day (UTC)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
