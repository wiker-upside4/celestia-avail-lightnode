    {
      "id": 3,
      "type": "timeseries",
      "title": "Avail Avg Blob Count / Block by Namespace",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
