{
  "uid": "dabeat-namespace",
  "title": "DABEAT \u2014 Namespace Activity",
  "tags": [
    "dabeat"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "heatmap",
      "title": "Avail Activity Heatmap (blob_count by app_id, 1h bucket)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('1 hour', no.ts) AS time,\n              COALESCE(mn.rollup_name, no.namespace_or_appid) AS metric,\n              SUM(no.blob_count) AS value\n       FROM namespace_observations no\n       LEFT JOIN monitored_namespaces mn ON mn.da_layer=no.da_layer AND mn.namespace_or_appid=no.namespace_or_appid\n       WHERE no.da_layer='avail' AND $__timeFilter(no.ts)\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        }
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64
        }
      }
    },
