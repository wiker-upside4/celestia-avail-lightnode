      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('5 minute', no.ts) AS time,\n              COALESCE(mn.rollup_name, no.namespace_or_appid) AS metric,\n              AVG(no.blob_count) AS value\n       FROM namespace_observations no\n       LEFT JOIN monitored_namespaces mn ON mn.da_layer=no.da_layer AND mn.namespace_or_appid=no.namespace_or_appid\n       WHERE no.da_layer='avail' AND $__timeFilter(no.ts)\n       GROUP BY 1, 2 ORDER BY 1",
