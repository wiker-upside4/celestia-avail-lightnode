    {
      "id": 4,
      "type": "timeseries",
      "title": "Fetch Success Rate per Namespace (Avail, 5m)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('5 minute', no.ts) AS time,\n              COALESCE(mn.rollup_name, no.namespace_or_appid) AS metric,\n              100.0 * COUNT(*) FILTER (WHERE no.fetch_success) / NULLIF(COUNT(*),0) AS value\n       FROM namespace_observations no\n       LEFT JOIN monitored_namespaces mn ON mn.da_layer=no.da_layer AND mn.namespace_or_appid=no.namespace_or_appid\n       WHERE no.da_layer='avail' AND $__timeFilter(no.ts)\n       GROUP BY 1, 2 ORDER BY 1",
