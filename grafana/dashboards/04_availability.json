    {
      "id": 7,
      "type": "timeseries",
      "title": "Pseudo Survival: success rate vs block age (s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM (s.ts - h.block_time))::int AS time,\n              s.da_layer AS metric,\n              CASE WHEN s.da_layer='celestia' THEN\n                100.0 * COUNT(*) FILTER (WHERE s.available) / NULLIF(COUNT(*),0)\n              ELSE\n                100.0 * COUNT(*) FILTER (WHERE s.confidence >= 92) / NULLIF(COUNT(*),0)\n              END AS value\n       FROM block_availability_samples s\n       JOIN headers h ON h.da_layer=s.da_layer AND h.height=s.height\n       WHERE h.block_time IS NOT NULL AND $__timeFilter(s.ts)\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4,
            "fillOpacity": 10,
            "axisLabel": ""
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
