    {
      "id": 5,
      "type": "timeseries",
      "title": "Submit Rate (per 5min bucket)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('5 minute', ts) AS time,\n              da_layer AS metric,\n              COUNT(*) AS value\n       FROM probes WHERE submit_success AND $__timeFilter(ts)\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
