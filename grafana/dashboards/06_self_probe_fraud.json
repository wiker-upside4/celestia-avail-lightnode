    {
      "id": 6,
      "type": "timeseries",
      "title": "Submit Latency p50/p95 (ms)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('5 minute', ts) AS time,\n              da_layer || '_p50' AS metric,\n              percentile_cont(0.5) WITHIN GROUP (ORDER BY submit_latency_ms) AS value\n       FROM probes WHERE submit_success AND $__timeFilter(ts)\n       GROUP BY 1, da_layer\n       UNION ALL\n       SELECT time_bucket('5 minute', ts) AS time,\n              da_layer || '_p95' AS metric,\n              percentile_cont(0.95) WITHIN GROUP (ORDER BY submit_latency_ms) AS value\n       FROM probes WHERE submit_success AND $__timeFilter(ts)\n       GROUP BY 1, da_layer\n       ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4,
            "fillOpacity": 10,
            "axisLabel": ""
          },
          "thresholds": {
