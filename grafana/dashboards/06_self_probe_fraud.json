          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retrieval Success Rate by Bucket (Survival Curve)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT time_bucket('15 minute', ts) AS time,\n              da_layer || '_' || bucket_label AS metric,\n              100.0 * COUNT(*) FILTER (WHERE fetch_success) / NULLIF(COUNT(*), 0) AS value\n       FROM retrievals WHERE $__timeFilter(ts)\n       GROUP BY 1, da_layer, bucket_label ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
