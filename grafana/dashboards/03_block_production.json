{
  "uid": "dabeat-blocks",
  "title": "DABEAT \u2014 Block Production",
  "tags": [
    "dabeat"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Block Time (s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "WITH t AS (\n         SELECT da_layer, height, block_time,\n                LAG(block_time) OVER (PARTITION BY da_layer ORDER BY height) AS prev_t\n         FROM headers WHERE block_time IS NOT NULL AND $__timeFilter(ts)\n       )\n       SELECT time_bucket('5 minute', block_time) AS time,\n              da_layer AS metric,\n              AVG(EXTRACT(EPOCH FROM (block_time - prev_t))) AS value\n       FROM t WHERE prev_t IS NOT NULL\n       GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4,
            "fillOpacity": 10,
            "axisLabel": ""
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
