    {
      "id": 9,
      "type": "table",
      "title": "Retention: Claim vs Measured",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "\n            SELECT\n              m.da_layer AS \"DA\",\n              m.native_token AS \"Token\",\n              m.retention_policy AS \"Policy\",\n              m.retention_days_claim AS \"Claim (days)\",\n              ROUND(EXTRACT(EPOCH FROM (NOW() - MIN(p.ts))) / 86400.0, 1) AS \"Measured Span (days)\",\n              COALESCE(\n                ROUND(100.0 * COUNT(r.*) FILTER (WHERE r.fetch_success) / NULLIF(COUNT(r.*), 0), 2),\n                NULL\n              ) AS \"All-Bucket Retrieval %\",\n              m.notes AS \"Notes\"\n            FROM da_layer_metadata m\n            LEFT JOIN probes p ON p.da_layer = m.da_layer AND p.submit_success\n            LEFT JOIN retrievals r ON r.probe_id = p.probe_id\n            GROUP BY m.da_layer, m.native_token, m.retention_policy, m.retention_days_claim, m.notes\n            ORDER BY m.da_layer\n        ",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Survival Curve \u2014 bucket \u00d7 layer (24h)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dabeat-pg"
