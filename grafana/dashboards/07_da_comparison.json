          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dabeat-pg"
          },
          "rawSql": "SELECT date_trunc('hour', ts) AS time,\n              da_layer || '_' || bucket_label AS metric,\n              100.0 * COUNT(*) FILTER (WHERE fetch_success) / NULLIF(COUNT(*), 0) AS value\n       FROM retrievals WHERE $__timeFilter(ts)\n       GROUP BY 1, da_layer, bucket_label\n       ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
